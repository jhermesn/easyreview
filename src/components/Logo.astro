---
// Original mark: a certification-style hexagon with a review check inside.
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: className } = Astro.props;
---
<svg class:list={['logo', className]} width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
  <path d="M16 2.5 27.7 9.25v13.5L16 29.5 4.3 22.75V9.25Z" fill="#161d26" stroke="#ff9900" stroke-width="2.2" stroke-linejoin="round" />
  <path d="M10.2 16.4 14.4 20.4 22 12" fill="none" stroke="#00e582" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" />
</svg>
