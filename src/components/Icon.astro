  check: 'M5 12.5 10 17l9-10',
  'check-circle': 'M12 3a9 9 0 1 1 0 18a9 9 0 0 1 0-18ZM8 12.5l2.7 2.5L16 9.5',
  circle: 'M12 3a9 9 0 1 1 0 18a9 9 0 0 1 0-18Z',
  target: 'M12 3a9 9 0 1 1 0 18a9 9 0 0 1 0-18ZM12 7.5a4.5 4.5 0 1 1 0 9a4.5 4.5 0 0 1 0-9ZM12 11.2a.8.8 0 1 1 0 1.6a.8.8 0 0 1 0-1.6Z',
