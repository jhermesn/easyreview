---
import { formatRich, jsonForScript } from '../lib/format';
import Icon from './Icon.astro';

export interface DeckCard {
  id: string;
  topic: string;
  topicTitle: string;
  domain: string;
  q: string;
  a: string;
  trap: boolean;
}
interface Props {
  cards: DeckCard[];
  filters?: boolean;
}
const { cards, filters = false } = Astro.props;
const payload = cards.map((c) => ({ ...c, q: formatRich(c.q), a: formatRich(c.a) }));
const topics = [...new Map(cards.map((c) => [c.topic, c.topicTitle])).entries()];
const grades = [
  { id: 'again', label: 'Again', key: '1', cls: 'bad' },
  { id: 'hard', label: 'Hard', key: '2', cls: '' },
  { id: 'good', label: 'Good', key: '3', cls: 'ok' },
  { id: 'easy', label: 'Easy', key: '4', cls: 'easy' },
];
---
<section class="deck" data-deck>
  <script type="application/json" data-cards set:html={jsonForScript(payload)} />
  <div class="bar">
    {filters && (
      <details class="pick" data-pick>
        <summary><Icon name="layers" size={15} /> <span data-pick-label>All topics</span></summary>
        <div class="pick-panel">
          <div class="pick-actions">
            <button type="button" data-pick-all>All</button>
            <button type="button" data-pick-none>None</button>
          </div>
          <ul>
            {topics.map(([slug, title]) => (
              <li><label><input type="checkbox" value={slug} checked data-pick-box /> <span>{title}</span></label></li>
            ))}
          </ul>
        </div>
      </details>
    )}
    <select data-mode aria-label="Which cards">
      <option value="smart">Due + new</option>
      <option value="due">Only due</option>
      <option value="known">Known cards</option>
      <option value="missed">Only missed</option>
      <option value="traps">Only exam traps</option>
      <option value="all">All, shuffled</option>
    </select>
    <span class="nav">
      <button type="button" data-prev title="Previous card (←)" aria-label="Previous card"><Icon name="arrow-left" size={15} /></button>
      <span class="count muted" data-count></span>
      <button type="button" data-next title="Next card (→)" aria-label="Next card"><Icon name="arrow-right" size={15} /></button>
    </span>
  </div>

  <div class="stage" data-flash tabindex="0" aria-live="polite" title="Flip (space)">
    <div class="card" data-card>
      <div class="face front">
        <div class="meta"><span data-meta></span><span class="trap" data-trap hidden><Icon name="alert" size={14} /> trap</span></div>
        <div class="q" data-q></div>
        <span class="hint"><Icon name="flip" size={13} /> tap to flip</span>
      </div>
      <div class="face back">
        <div class="meta"><span>Answer</span><span class="muted" data-due></span></div>
        <div class="a" data-a></div>
      </div>
    </div>
    <p class="empty muted" data-empty hidden>Nothing to review here right now. Pick other topics or another filter.</p>
  </div>

  <div class="controls">
    <button class="btn-primary" data-flip title="Show answer (space)"><Icon name="flip" /> Answer</button>
    <div class="grades" data-grades hidden>
      {grades.map((g) => (
        <button type="button" class={g.cls} data-grade={g.id} title={`${g.label} (${g.key})`}>
          <span>{g.label}</span><small data-ivl={g.id}></small>
        </button>
      ))}
    </div>
  </div>
  <p class="stats muted"><span data-stats></span> · <button class="link" data-reset title="Reset progress for the selected topics"><Icon name="reset" size={13} /></button></p>
</section>

<style>
  .deck { margin: 1rem 0 2rem; }
  .bar { display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center; margin-bottom: 0.8rem; }
  .nav { margin-left: auto; display: inline-flex; align-items: center; gap: 0.35rem; }
  .nav button { padding: 0.25rem 0.45rem; display: inline-grid; place-items: center; }
  .count { font-size: 0.8rem; min-width: 4.5rem; text-align: center; }

  .pick { position: relative; }
  .pick summary { list-style: none; display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.45rem 0.8rem; border: 1px solid var(--ink-500); background: var(--ink-850); color: var(--ink-100); cursor: pointer; }
  .pick summary::-webkit-details-marker { display: none; }
  .pick[open] summary { border-color: var(--amber); }
  .pick-panel { position: absolute; z-index: 10; top: calc(100% + 4px); left: 0; width: min(24rem, 86vw); max-height: 22rem; overflow-y: auto; padding: 0.6rem; background: var(--ink-900); border: 1px solid var(--ink-500); box-shadow: 0 12px 30px rgb(0 0 0 / 0.5); }
  .pick-actions { display: flex; gap: 0.4rem; margin-bottom: 0.4rem; }
  .pick-actions button { padding: 0.1rem 0.6rem; font-size: 0.78rem; }
  .pick ul { list-style: none; margin: 0; padding: 0; }
  .pick label { display: flex; align-items: center; gap: 0.55rem; padding: 0.25rem 0.3rem; cursor: pointer; font-size: 0.85rem; line-height: 1.35; }
  .pick label:hover { background: var(--ink-850); }
  .pick input { accent-color: var(--mint); width: 1rem; height: 1rem; flex: none; }

  .stage { perspective: 1400px; outline: none; cursor: pointer; }
  .stage:focus-visible .face { border-color: var(--mint); }
  .card { display: grid; transform-style: preserve-3d; transition: transform 0.55s cubic-bezier(0.3, 0.7, 0.2, 1); }
  .card:global(.flipped) { transform: rotateY(180deg); }
  .card:global(.instant) { transition: none; }
  .card:global(.enter) { animation: deal 0.35s ease-out; }
  @keyframes deal { from { opacity: 0; transform: translateX(24px) rotate(1.5deg); } to { opacity: 1; transform: none; } }
  .face {
    grid-area: 1 / 1; min-height: 15rem; padding: 1.1rem 1.3rem 2.2rem; display: flex; flex-direction: column;
    background: linear-gradient(160deg, var(--ink-800), var(--ink-850) 60%); border: 1px solid var(--ink-700); border-radius: 10px;
    box-shadow: 0 10px 28px rgb(0 0 0 / 0.35); backface-visibility: hidden; -webkit-backface-visibility: hidden; line-height: 1.7;
  }
  .front { position: relative; }
  .back { transform: rotateY(180deg); border-color: color-mix(in srgb, var(--purple) 55%, var(--ink-700)); }
  .meta { display: flex; gap: 0.5rem; justify-content: space-between; font-size: 0.75rem; color: var(--ink-300); margin-bottom: 0.7rem; }
  .trap { display: inline-flex; align-items: center; gap: 0.3rem; color: var(--yellow); font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; }
  .q { font-size: 1.05rem; font-weight: 700; margin: auto 0; }
  .a { margin: auto 0; }
  .hint { position: absolute; bottom: 0.7rem; right: 1rem; display: inline-flex; align-items: center; gap: 0.3rem; font-size: 0.7rem; color: var(--ink-400); }
  .q :global(p), .a :global(p) { margin: 0.25rem 0; }
  .a :global(ul) { margin: 0.3rem 0; padding-left: 1.2rem; list-style: square; }
  .empty { padding: 2rem 0; text-align: center; }

  .controls { display: flex; gap: 0.5rem; margin-top: 0.9rem; flex-wrap: wrap; }
  .controls > button { display: inline-flex; align-items: center; gap: 0.4rem; }
  .grades { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.4rem; width: 100%; max-width: 30rem; }
  .grades button { display: grid; justify-items: center; line-height: 1.3; padding: 0.35rem 0.4rem; }
  .grades small { font-size: 0.68rem; opacity: 0.8; }
  button.easy { border-color: var(--purple); color: var(--purple); }
  .stats { font-size: 0.8rem; }
  button.link { background: none; border: none; padding: 0; color: var(--ink-300); text-decoration: underline dotted; font-size: inherit; }
</style>

<script>
  import { KEYS, readJson, writeJson } from '../lib/storage';

  import { GRADES, describeDelay, isDue, isKnown, isNew, normalize, schedule, type CardState, type Grade } from '../lib/srs';

  type Card = { id: string; topic: string; topicTitle: string; domain: string; q: string; a: string; trap: boolean };
  type Progress = Record<string, CardState>;

  const load = (): Progress => {
    const raw = readJson<Record<string, unknown>>(KEYS.progress, {});
    return Object.fromEntries(Object.entries(raw).flatMap(([id, v]) => {
      const s = normalize(v);
      return s ? [[id, s]] : [];
    }));
  };
  const save = (p: Progress) => writeJson(KEYS.progress, p);
  function shuffle<T>(xs: T[]): T[] {
    const a = [...xs];
    for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; }
    return a;
  }

  function setup(root: HTMLElement) {
    if (root.dataset.ready) return;
    root.dataset.ready = '1';
    const all: Card[] = JSON.parse(root.querySelector('[data-cards]')!.textContent!);
    const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const boxes = [...root.querySelectorAll<HTMLInputElement>('[data-pick-box]')];
    const modeSel = $<HTMLSelectElement>('[data-mode]');
    const card = $('[data-card]');
    let progress = load();
    let queue: Card[] = [];
    let pos = 0;
    let flipped = false;

    const params = new URLSearchParams(location.search);
    const preset = params.get('topic');
    if (preset && boxes.some((b) => b.value === preset)) boxes.forEach((b) => (b.checked = b.value === preset));
    if (params.get('mode')) modeSel.value = params.get('mode')!;

    // With no checkboxes (a single topic page) every card is in scope.
    const picked = () => (boxes.length ? new Set(boxes.filter((b) => b.checked).map((b) => b.value)) : null);
    const inScope = (c: Card, set = picked()) => !set || set.has(c.topic);
    const updateLabel = () => {
      const label = root.querySelector('[data-pick-label]');
      if (!label) return;
      const on = boxes.filter((b) => b.checked);
      label.textContent = on.length === boxes.length ? 'All topics' : on.length === 0 ? 'No topics' : on.length === 1 ? on[0].nextElementSibling!.textContent! : `${on.length} topics`;
    };

    const build = () => {
      const set = picked();
      const now = Date.now();
      const pool = all.filter((c) => inScope(c, set));
      const state = (c: Card) => progress[c.id];
      const byDue = (a: Card, b: Card) => state(a)!.due - state(b)!.due;
      const filters: Record<string, () => Card[]> = {
        smart: () => [...pool.filter((c) => isDue(state(c), now)).sort(byDue), ...shuffle(pool.filter((c) => isNew(state(c))))],
        due: () => pool.filter((c) => isDue(state(c), now)).sort(byDue),
        known: () => shuffle(pool.filter((c) => isKnown(state(c)))),
        missed: () => shuffle(pool.filter((c) => state(c)?.last === 'miss')),
        traps: () => shuffle(pool.filter((c) => c.trap)),
        all: () => shuffle(pool),
      };
      queue = (filters[modeSel.value] ?? filters.smart)();
      pos = 0;
      updateLabel();
      render();
    };

    const render = () => {
      const c = queue[pos];
      // Turn the card face-up without animating, then deal it in.
      card.classList.add('instant');
      card.classList.remove('flipped', 'enter');
      void card.offsetWidth;
      card.classList.remove('instant');
      if (c) card.classList.add('enter');
      flipped = false;
      card.hidden = !c;
      $('[data-empty]').hidden = !!c;
      $('[data-q]').innerHTML = c?.q ?? '';
      $('[data-a]').innerHTML = c?.a ?? '';
      $('[data-meta]').textContent = c ? c.topicTitle : '';
      $('[data-trap]').hidden = !c?.trap;
      const s = c ? progress[c.id] : undefined;
      $('[data-due]').textContent = s ? (isDue(s) ? 'due now' : `next in ${describeDelay(s.due - Date.now())}`) : 'new';
      $('[data-flip]').hidden = !c;
      $('[data-grades]').hidden = true;
      $('[data-count]').textContent = queue.length ? `${pos + 1} / ${queue.length}` : '0';
      $<HTMLButtonElement>('[data-prev]').disabled = pos <= 0;
      $<HTMLButtonElement>('[data-next]').disabled = pos >= queue.length - 1;
      const now = Date.now();
      const scoped = all.filter((x) => inScope(x));
      const due = scoped.filter((x) => isDue(progress[x.id], now)).length;
      const fresh = scoped.filter((x) => isNew(progress[x.id])).length;
      const known = scoped.filter((x) => isKnown(progress[x.id])).length;
      $('[data-stats]').textContent = `${due} due · ${fresh} new · ${known}/${scoped.length} known`;
    };

    const flip = () => {
      const c = queue[pos];
      if (!c) return;
      flipped = !flipped;
      card.classList.toggle('flipped', flipped);
      $('[data-flip]').hidden = flipped;
      $('[data-grades]').hidden = !flipped;
      if (flipped) {
        const now = Date.now();
        for (const g of GRADES) $(`[data-ivl="${g}"]`).textContent = describeDelay(schedule(progress[c.id], g, now).due - now);
      }
    };

    const grade = (g: Grade) => {
      const c = queue[pos];
      if (!c || !flipped) return;
      progress[c.id] = schedule(progress[c.id], g);
      save(progress);
      queue.splice(pos, 1);
      // "Again" comes back later in this session, like Anki's learning step.
      if (g === 'again') queue.splice(Math.min(pos + 3, queue.length), 0, c);
      pos = Math.min(pos, Math.max(0, queue.length - 1));
      render();
    };
    const move = (step: number) => {
      const next = pos + step;
      if (next < 0 || next >= queue.length) return;
      pos = next;
      render();
    };

    $('[data-flash]').addEventListener('click', flip);
    $('[data-flip]').addEventListener('click', flip);
    root.querySelectorAll<HTMLButtonElement>('[data-grade]').forEach((b) => b.addEventListener('click', () => grade(b.dataset.grade as Grade)));
    $('[data-prev]').addEventListener('click', () => move(-1));
    $('[data-next]').addEventListener('click', () => move(1));
    $('[data-reset]').addEventListener('click', () => {
      all.filter((c) => inScope(c)).forEach((c) => delete progress[c.id]);
      save(progress);
      build();
    });
    boxes.forEach((b) => b.addEventListener('change', build));
    root.querySelector('[data-pick-all]')?.addEventListener('click', () => { boxes.forEach((b) => (b.checked = true)); build(); });
    root.querySelector('[data-pick-none]')?.addEventListener('click', () => { boxes.forEach((b) => (b.checked = false)); build(); });
    modeSel.addEventListener('change', build);
    const pick = root.querySelector<HTMLDetailsElement>('[data-pick]');
    const closePick = (ev: MouseEvent) => {
      if (!root.isConnected) { document.removeEventListener('click', closePick); return; }
      if (pick?.open && !pick.contains(ev.target as Node)) pick.open = false;
    };
    document.addEventListener('click', closePick);

    const onKey = (ev: KeyboardEvent) => {
      if (!root.isConnected) { document.removeEventListener('keydown', onKey); return; }
      if ((ev.target as HTMLElement).closest('input, select, textarea, summary')) return;
      if (ev.key === ' ') { ev.preventDefault(); flip(); }
      else if (ev.key === 'ArrowLeft') move(-1);
      else if (ev.key === 'ArrowRight') move(1);
      else if (flipped && ['1', '2', '3', '4'].includes(ev.key)) grade(GRADES[Number(ev.key) - 1]);
    };
    document.addEventListener('keydown', onKey);
    build();
  }

  document.addEventListener('astro:page-load', () => {
    const decks = document.querySelectorAll<HTMLElement>('[data-deck]');
    if (decks.length) setup(decks[0]);
  });
</script>
