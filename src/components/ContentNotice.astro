---
// Shown when some of a page's study content has no translation in the reader's language yet.
// `langs`: the language of each piece of content on the page.
import Icon from './Icon.astro';
import { DEFAULT_LOCALE, localeOf, useTranslations, type Locale } from '../i18n';

interface Props { langs: Locale[] }
const locale = localeOf(Astro.currentLocale);
const t = useTranslations(locale);
const english = Astro.props.langs.filter((l) => l === DEFAULT_LOCALE).length;
const message = english === Astro.props.langs.length ? t('content.english') : t('content.partial');
const HELP = 'https://github.com/jhermesn/easyreview/blob/main/docs/translations.md';
---
{locale !== DEFAULT_LOCALE && english > 0 && (
  <p class="notice" lang={locale}>
    <Icon name="globe" size={15} />
    <span>{message} <a href={HELP} target="_blank" rel="noopener">{t('content.help')}</a></span>
  </p>
)}

<style>
  .notice { display: flex; align-items: flex-start; gap: 0.5rem; margin: 0 0 1.2rem; padding: 0.6rem 0.8rem; border: 1px solid var(--ink-700); border-left: 3px solid var(--purple); background: var(--ink-900); color: var(--ink-300); font-size: 0.82rem; }
  .notice :global(svg) { flex: none; margin-top: 0.15rem; color: var(--purple); }
</style>
