---
// Topics the reader marked known that changed afterwards (lib/known.ts shows each item while one of its
// sections is updated, and the block while any item is). Items are units on a cert page, certs on the home page.
import Icon from './Icon.astro';
import { localeOf, useTranslations } from '../i18n';

interface Props {
  items: { href: string; label: string; ids: string }[];
}
const { items } = Astro.props;
const t = useTranslations(localeOf(Astro.currentLocale));
---
{items.length > 0 && (
  <section class="updated" id="updated" data-updated-list hidden>
    <h2><Icon name="alert" size={16} /> {t('updated.title')}</h2>
    <p class="muted">{t('updated.text')}</p>
    <ul>
      {items.map((i) => <li data-updated-only={i.ids} hidden><a href={i.href}>{i.label}</a></li>)}
    </ul>
  </section>
)}

<style>
  .updated { margin: 1rem 0; padding: 0.7rem 0.9rem; border: 1px solid color-mix(in srgb, var(--amber) 45%, var(--ink-700)); background: color-mix(in srgb, var(--amber) 6%, var(--ink-850)); }
  h2 { display: flex; align-items: center; gap: 0.45rem; margin: 0; font-size: 0.95rem; color: var(--amber); }
  p { margin: 0.3rem 0 0.5rem; font-size: 0.85rem; }
  ul { display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; margin: 0; padding: 0; list-style: none; font-size: 0.88rem; }
</style>
