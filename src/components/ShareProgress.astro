---
// Lets a reader share a finished topic or cert. It shows once every section in `ids` is known, or once
// `cert` is complete (lib/known.ts adds .is-known), and uses plain share links, so no social network
// script loads on the page.
import Icon from './Icon.astro';
import { shareLinks } from '../lib/share';
import { localeOf, useTranslations } from '../i18n';

type Props = { title: string; text: string; url: string } & ({ ids: string; cert?: never } | { cert: string; ids?: never });
const { ids, cert, title, text, url } = Astro.props;
const t = useTranslations(localeOf(Astro.currentLocale));
---
<details class="share" data-known={ids} data-known-cert={cert} data-share data-share-text={text} data-share-url={url}>
  <summary class="btn"><Icon name="share" size={16} /> {t('share.button')}</summary>
  <div class="panel">
    <p class="title">{title}</p>
    <p class="note muted">{text}</p>
    <button type="button" data-share-native hidden><Icon name="share" size={15} /> {t('share.device')}</button>
    <ul>
      {shareLinks(text, url).map((l) => (
        <li><a href={l.href} target="_blank" rel="noopener noreferrer">{l.name} <Icon name="external" size={13} /></a></li>
      ))}
    </ul>
    <button type="button" data-share-copy><Icon name="docs" size={15} /> <span data-share-copy-label>{t('share.copy')}</span></button>
  </div>
</details>

<style>
  .share { display: none; position: relative; vertical-align: top; margin-left: 0.4rem; }
  .share:global(.is-known) { display: inline-block; }
  .share summary { list-style: none; }
  .share summary::-webkit-details-marker { display: none; }
  .share summary:hover, .share[open] summary { color: var(--ink-100); border-color: var(--amber); }
  .panel { position: absolute; left: 0; top: calc(100% + 6px); z-index: 40; width: min(18rem, calc(100vw - 2rem)); padding: 0.8rem; background: var(--ink-900); border: 1px solid var(--ink-500); box-shadow: 0 12px 30px rgb(0 0 0 / 0.5); display: grid; gap: 0.45rem; }
  .title { margin: 0; font-weight: 700; }
  .note { margin: 0; font-size: 0.78rem; line-height: 1.45; }
  .panel ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0.3rem; }
  .panel ul a { display: flex; align-items: center; justify-content: space-between; gap: 0.3rem; padding: 0.35rem 0.5rem; border: 1px solid var(--ink-700); text-decoration: none; color: var(--ink-300); font-size: 0.82rem; }
  .panel ul a:hover { color: var(--ink-100); border-color: var(--ink-500); }
  .panel button { display: inline-flex; align-items: center; gap: 0.4rem; justify-content: center; }
</style>

<script>
  import { clientT } from '../i18n';

  document.addEventListener('astro:page-load', () => {
    const t = clientT();
    document.querySelectorAll<HTMLDetailsElement>('[data-share]').forEach((root) => {
      if (root.dataset.ready) return;
      root.dataset.ready = '1';
      const text = root.dataset.shareText!;
      const url = root.dataset.shareUrl!;
      // Phones open the system share sheet, which reaches every installed app.
      const native = root.querySelector<HTMLButtonElement>('[data-share-native]')!;
      if (typeof navigator.share === 'function') {
        native.hidden = false;
        native.addEventListener('click', () => navigator.share({ text, url }).catch(() => undefined));
      }
      // The button sits beside others, so on a narrow screen the panel shifts left to stay on screen.
      const panel = root.querySelector<HTMLElement>('.panel')!;
      root.addEventListener('toggle', () => {
        panel.style.left = '';
        if (!root.open) return;
        const overflow = panel.getBoundingClientRect().right - (document.documentElement.clientWidth - 16);
        if (overflow > 0) panel.style.left = `${-overflow}px`;
      });
      const copy = root.querySelector<HTMLButtonElement>('[data-share-copy]')!;
      const label = root.querySelector<HTMLElement>('[data-share-copy-label]')!;
      copy.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(`${text} ${url}`);
          label.textContent = t('share.copied');
        } catch {
          label.textContent = t('share.copyFailed');
        }
        setTimeout(() => (label.textContent = t('share.copy')), 2000);
      });
    });
  });
</script>
