---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PersonCard, { type Person } from '../components/PersonCard.astro';
import { goldenJacketCerts } from '../lib/certs';
import { TIERS, credlyAwsCerts, githubApi, passedEntry, tierOf } from '../lib/passed';

const HOW_TO = 'https://github.com/jhermesn/easyreview/blob/main/CONTRIBUTING.md#add-yourself-to-who-passed';
const total = goldenJacketCerts().length;
const tierName = Object.fromEntries(TIERS.map((t) => [t.id, t.name]));

// A malformed entry fails the build with its file name. A profile that can't be loaded (GitHub or Credly down)
// is left out of this build with a warning instead of failing the deploy.
const files = import.meta.glob<{ default: unknown }>('../content/passed/*.json', { eager: true });
const loaded = await Promise.all(
  Object.entries(files).map(async ([file, mod]): Promise<Person | undefined> => {
    const parsed = passedEntry.safeParse(mod.default);
    if (!parsed.success) throw new Error(`${file}: ${parsed.error.issues.map((i) => `${i.path.join('.')} ${i.message}`).join('; ')}`);
    const entry = parsed.data;
    try {
      const [user, earned] = await Promise.all([githubApi(`users/${entry.github}`, process.env.GH_TOKEN), credlyAwsCerts(entry.credly)]);
      if (!earned.length) return undefined;
      return {
        login: entry.github,
        name: user.name || entry.github,
        bio: user.bio || undefined,
        avatar: typeof user.avatar_url === 'string' ? user.avatar_url : undefined,
        credly: entry.credly,
        linkedin: entry.linkedin,
        builder: entry.builder,
        earned,
        active: earned.filter((e) => e.active).length,
        latest: earned.map((e) => e.issued).sort().at(-1)!,
        tier: tierOf(earned),
      };
    } catch (err) {
      console.warn(`[passed] skipped ${entry.github}: ${(err as Error).message}`);
      return undefined;
    }
  }),
);
const people = loaded.filter((p): p is Person => !!p);
const byCount = (a: Person, b: Person) => b.active - a.active || b.latest.localeCompare(a.latest) || a.name.localeCompare(b.name);
const groups = TIERS.map((t) => ({ ...t, list: people.filter((p) => p.tier === t.id).sort(byCount) })).filter((g) => g.list.length);
const recent = [...people].sort((a, b) => b.latest.localeCompare(a.latest) || byCount(a, b));
---
<Base title="Who passed" description="People who studied with Easy Review and passed their AWS Certification exams, each checked against their public Credly badges.">
  <div class="article">
    <h1>Who passed</h1>
    <p class="muted">People who studied here and passed. Each person adds themselves; their certifications come from their public Credly badges, and their photo and description from GitHub. Tiers follow the Golden Jackets Brazil community.</p>
    <a class="btn add" href={HOW_TO} target="_blank" rel="noopener"><Icon name="check-circle" /> Add yourself <Icon name="external" size={12} /></a>
  </div>

  {people.length === 0 ? (
    <p class="empty">Nobody here yet. Passed an exam? Be the first.</p>
  ) : (
    <>
      <div class="sort" role="tablist" aria-label="Order" data-tabs>
        <button type="button" role="tab" id="tab-most" aria-controls="panel-most" aria-selected="true">Most certified</button>
        <button type="button" role="tab" id="tab-recent" aria-controls="panel-recent" aria-selected="false">Recently updated</button>
      </div>

      <section role="tabpanel" id="panel-most" aria-labelledby="tab-most">
        {groups.map((g) => (
          <section class:list={['group', `group-${g.id}`]} id={g.id}>
            <h2>{g.name} <span class="n">{g.list.length}</span></h2>
            <p class="muted note">{g.note}</p>
            <ul class="people">{g.list.map((p) => <PersonCard person={p} total={total} tierName={tierName[p.tier]} />)}</ul>
          </section>
        ))}
      </section>

      <section role="tabpanel" id="panel-recent" aria-labelledby="tab-recent">
        <ul class="people">{recent.map((p) => <PersonCard person={p} total={total} tierName={tierName[p.tier]} />)}</ul>
      </section>
    </>
  )}
</Base>

<style>
  .add { margin-top: 0.6rem; }
  .empty { color: var(--ink-300); border: 1px dashed var(--ink-700); padding: 1.2rem; text-align: center; margin-top: 1.6rem; }
  .sort { display: flex; gap: 0.4rem; margin: 1.6rem 0 1rem; border-bottom: 1px solid var(--ink-700); flex-wrap: wrap; }
  .sort button { background: none; border: 0; border-bottom: 2px solid transparent; color: var(--ink-300); font: inherit; font-size: 0.86rem; padding: 0.5rem 0.7rem; cursor: pointer; margin-bottom: -1px; }
  .sort button[aria-selected='true'] { color: var(--ink-100); border-bottom-color: var(--amber); }
  .group { margin-bottom: 1.6rem; }
  .group h2 { font-size: 1rem; margin: 0 0 0.2rem; }
  .group-golden h2 { background: var(--gold-sheen); -webkit-background-clip: text; background-clip: text; color: transparent; width: fit-content; }
  .n { font-size: 0.75rem; color: var(--ink-400); }
  .note { font-size: 0.8rem; margin: 0 0 0.7rem; }
  .people { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr)); gap: 0.6rem; }
</style>

<script>
  // The URL hash picks the order (#recent); a tier id (#golden) opens "Most certified" at that group.
  const tabs = () => [...document.querySelectorAll<HTMLButtonElement>('[data-tabs] [role="tab"]')];
  function show(tab: HTMLButtonElement) {
    for (const t of tabs()) {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
    }
  }
  const fromHash = () => {
    const all = tabs();
    if (all.length) show(all.find((t) => location.hash === `#${t.id.replace('tab-', '')}`) ?? all[0]);
  };
  window.addEventListener('hashchange', fromHash);
  document.addEventListener('astro:page-load', () => {
    tabs().forEach((t) =>
      t.addEventListener('click', () => {
        show(t);
        history.replaceState(null, '', t.id === 'tab-recent' ? '#recent' : location.pathname);
      }),
    );
    fromHash();
  });
</script>
