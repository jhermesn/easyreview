---
import Base from '../layouts/Base.astro';
import { availableCerts } from '../lib/certs';
import { withBase } from '../lib/format';
---
<Base title="Page not found" description="This page does not exist on Easy Review." noindex>
  <div class="article">
    <h1>Page not found</h1>
    <p class="muted">This page does not exist, or it moved when topics were split into units.</p>
    <ul>
      {availableCerts().map((c) => <li><a href={withBase(`/${c.id}`)}>{c.code} {c.name}</a></li>)}
      <li><a href={withBase('/search')}>Search every topic</a></li>
      <li><a href={withBase('/')}>All certifications</a></li>
    </ul>
  </div>
</Base>
