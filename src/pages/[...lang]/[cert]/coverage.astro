---
import Base from '../../../layouts/Base.astro';
import { availableCerts, getCert } from '../../../lib/certs';
import { getCertView, getContent, orphanSections, sectionHref } from '../../../lib/content';
import { getGuide, guideProblems, servicesCoverage } from '../../../lib/guides';
import { DEFAULT_LOCALE, localeOf, localeParams, localePath, useTranslations } from '../../../i18n';
import ContentNotice from '../../../components/ContentNotice.astro';

export function getStaticPaths() {
  return localeParams(availableCerts().filter((c) => getGuide(c.id)).map((c) => ({ params: { cert: c.id } })));
}
const locale = localeOf(Astro.currentLocale);
const t = useTranslations(locale);
const cert = getCert(Astro.params.cert!);
const guide = getGuide(cert.id)!;
const view = await getCertView(cert.id);
const { sections } = await getContent();
const items = guide.domains.flatMap((d) => d.tasks.flatMap((t) => t.items));
const covered = items.filter((i) => i.sections.length).length;
const services = servicesCoverage(guide, view);
const allServices = services.flatMap((c) => c.services);
const problems = guideProblems(guide, view);
// Reported once, from the default-locale build of the page.
if (problems.length && locale === DEFAULT_LOCALE) {
  const report = `[coverage ${cert.id}] ${problems.length} gaps:\n  ${problems.join('\n  ')}`;
  // CI's content health check sets STRICT_COVERAGE=1 so a gap fails the build instead of warning.
  if (process.env.STRICT_COVERAGE === '1') throw new Error(report);
  console.warn(report);
}
// Reported once per build: content no cert's guide asks for is either a mapping gap or extra reading.
if (cert.id === availableCerts()[0].id && locale === DEFAULT_LOCALE) {
  const orphans = await orphanSections(availableCerts().map((c) => c.id));
  if (orphans.length) {
    // A section no cert maps is built but unreachable: a missing guide mapping, or content to remove.
    const report = `[coverage] ${orphans.length} sections no cert maps:\n  ${orphans.join('\n  ')}`;
    if (process.env.STRICT_COVERAGE === '1') throw new Error(report);
    console.warn(report);
  }
}
const link = (id: string) => (sections.has(id) ? localePath(locale, sectionHref(cert.id, sections.get(id)!)) : '#');
const titleOf = (id: string) => sections.get(id)?.data.title ?? id;
---
<Base title={`${t('cov.title')} · ${cert.code}`} description={t('cov.description', { code: cert.code })} cert={cert.id} heading={t('cov.title')}>
  <div class="article">
    <h1>{t('cov.title')} <span class="muted">{cert.code}</span></h1>
    <p class="muted">
      {t('cov.intro.a')} <a href={guide.source} target="_blank" rel="noopener">{t('cov.intro.guide')}</a> {t('cov.intro.b', { date: guide.retrieved })}
    </p>
    <p>
      <span class:list={['pill', covered === items.length ? 'ok' : 'warn']}>{t('cov.itemsPill', { n: covered, total: items.length })}</span>
      <span class:list={['pill', allServices.every((s) => s.sections.length) ? 'ok' : 'warn']}>{t('cov.servicesPill', { n: allServices.filter((s) => s.sections.length).length, total: allServices.length })}</span>
    </p>
    <ContentNotice />

    {guide.domains.map((d) => (
      <section>
        <h2>{d.name}</h2>
        {d.tasks.map((task) => (
          <>
            <h3>{t('cov.task', { id: task.id })} {task.title}</h3>
            <ul class="items">
              {task.items.map((i) => (
                <li class:list={{ gap: !i.sections.length }}>
                  <span class="kind">{i.kind === 'skill' ? t('cov.skill') : t('cov.know')}</span>
                  {i.text}
                  <span class="links">{i.sections.length ? i.sections.map((id) => <a href={link(id)}>{titleOf(id)}</a>) : <b>{t('cov.notCovered')}</b>}</span>
                </li>
              ))}
            </ul>
          </>
        ))}
      </section>
    ))}

    <h2>{t('cov.services')}</h2>
    {services.map((c) => (
      <>
        <h3>{c.category}</h3>
        <ul class="services">
          {c.services.map((s) => (
            <li class:list={{ gap: !s.sections.length }} title={s.sections.map((x) => x.data.title).join(', ') || t('cov.noSection')}>
              {s.sections.length ? <a href={link(s.sections[0].id)}>{s.name}</a> : s.name}
              <small>{s.sections.length || '0'}</small>
            </li>
          ))}
        </ul>
      </>
    ))}
  </div>
</Base>

<style>
  .items { list-style: none; padding: 0; }
  .items li { padding: 0.35rem 0 0.35rem 0.6rem; border-left: 2px solid var(--mint); margin: 0.3rem 0; font-size: 0.88rem; line-height: 1.55; }
  .items li.gap { border-left-color: var(--magenta); }
  .kind { font-size: 0.68rem; text-transform: uppercase; color: var(--ink-400); margin-right: 0.4rem; }
  .links { display: block; font-size: 0.8rem; }
  /* Inline links sized to a 24px touch target. */
  .links a { display: inline-block; min-height: 24px; line-height: 24px; margin-right: 0.8rem; color: var(--ink-300); }
  .links b { color: var(--magenta); font-weight: 400; }
  .services { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .services li { border: 1px solid color-mix(in srgb, var(--mint) 45%, transparent); padding: 0.1rem 0.5rem; font-size: 0.8rem; }
  .services li.gap { border-color: var(--magenta); color: var(--magenta); }
  .services a { text-decoration: none; }
  .services small { color: var(--ink-400); margin-left: 0.35rem; }
</style>
