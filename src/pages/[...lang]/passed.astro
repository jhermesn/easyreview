---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import PersonCard from '../../components/PersonCard.astro';
import { goldenJacketCerts } from '../../lib/certs';
import { TIERS } from '../../lib/passed';
import { ADD_YOURSELF, loadPeople, type Person } from '../../lib/people';
import { localeOf, localeParams, useTranslations } from '../../i18n';

export const getStaticPaths = () => localeParams();
const t = useTranslations(localeOf(Astro.currentLocale));

const total = goldenJacketCerts().length;
const tierName = Object.fromEntries(TIERS.map((tier) => [tier.id, t(`tier.${tier.id}`)]));

const people = await loadPeople();
const byCount = (a: Person, b: Person) => b.active - a.active || b.latest.localeCompare(a.latest) || a.name.localeCompare(b.name);
const groups = TIERS.map((tier) => ({ id: tier.id, name: t(`tier.${tier.id}`), note: t(`tier.${tier.id}.note`), list: people.filter((p) => p.tier === tier.id).sort(byCount) })).filter((g) => g.list.length);
const recent = [...people].sort((a, b) => b.latest.localeCompare(a.latest) || byCount(a, b));
---
<Base title={t('footer.passed')} description={t('passed.description')}>
  <div class="article">
    <h1>{t('footer.passed')}</h1>
    <p class="muted">{t('passed.intro')}</p>
    <a class="btn add" href={ADD_YOURSELF} target="_blank" rel="noopener"><Icon name="check-circle" /> {t('passed.add')} <Icon name="external" size={12} /></a>
  </div>

  {people.length === 0 ? (
    <p class="empty">{t('passed.empty')}</p>
  ) : (
    <>
      <div class="sort" role="tablist" aria-label={t('passed.order')} data-tabs>
        <button type="button" role="tab" id="tab-most" aria-controls="panel-most" aria-selected="true">{t('passed.most')}</button>
        <button type="button" role="tab" id="tab-recent" aria-controls="panel-recent" aria-selected="false">{t('passed.recent')}</button>
      </div>

      <section role="tabpanel" id="panel-most" aria-labelledby="tab-most">
        {groups.map((g) => (
          <section class:list={['group', `group-${g.id}`]} id={g.id}>
            <h2>{g.name} <span class="n">{g.list.length}</span></h2>
            <p class="muted note">{g.note}</p>
            <ul class="people">{g.list.map((p) => <PersonCard person={p} total={total} tierName={tierName[p.tier]} />)}</ul>
          </section>
        ))}
      </section>

      <section role="tabpanel" id="panel-recent" aria-labelledby="tab-recent">
        <ul class="people">{recent.map((p) => <PersonCard person={p} total={total} tierName={tierName[p.tier]} />)}</ul>
      </section>
    </>
  )}
</Base>

<style>
  .add { margin-top: 0.6rem; }
  .empty { color: var(--ink-300); border: 1px dashed var(--ink-700); padding: 1.2rem; text-align: center; margin-top: 1.6rem; }
  .sort { display: flex; gap: 0.4rem; margin: 1.6rem 0 1rem; border-bottom: 1px solid var(--ink-700); flex-wrap: wrap; }
  .sort button { background: none; border: 0; border-bottom: 2px solid transparent; color: var(--ink-300); font: inherit; font-size: 0.86rem; padding: 0.5rem 0.7rem; cursor: pointer; margin-bottom: -1px; }
  .sort button[aria-selected='true'] { color: var(--ink-100); border-bottom-color: var(--amber); }
  .group { margin-bottom: 1.6rem; }
  .group h2 { font-size: 1rem; margin: 0 0 0.2rem; }
  .group-golden h2 { background: var(--gold-sheen); -webkit-background-clip: text; background-clip: text; color: transparent; width: fit-content; }
  .n { font-size: 0.75rem; color: var(--ink-400); }
  .note { font-size: 0.8rem; margin: 0 0 0.7rem; }
  .people { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr)); gap: 0.6rem; }
</style>

<script>
  // The URL hash picks the order (#recent); a tier id (#golden) opens "Most certified" at that group.
  const tabs = () => [...document.querySelectorAll<HTMLButtonElement>('[data-tabs] [role="tab"]')];
  function show(tab: HTMLButtonElement) {
    for (const t of tabs()) {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
    }
  }
  const fromHash = () => {
    const all = tabs();
    if (all.length) show(all.find((t) => location.hash === `#${t.id.replace('tab-', '')}`) ?? all[0]);
  };
  window.addEventListener('hashchange', fromHash);
  document.addEventListener('astro:page-load', () => {
    tabs().forEach((t) =>
      t.addEventListener('click', () => {
        show(t);
        history.replaceState(null, '', t.id === 'tab-recent' ? '#recent' : location.pathname);
      }),
    );
    fromHash();
  });
</script>
