---
import Base from '../../layouts/Base.astro';
import { availableCerts } from '../../lib/certs';
import { levelRank } from '../../lib/levels';
import { getCertView, sectionHref, unitIdOf } from '../../lib/content';
import { jsonForScript } from '../../lib/format';
import { localeOf, localeParams, localePath, useTranslations } from '../../i18n';

export const getStaticPaths = () => localeParams();
const locale = localeOf(Astro.currentLocale);
const t = useTranslations(locale);

// One entry per section. `links` holds the section's page in every cert that maps it, most advanced exam
// first: the client opens it in the cert the reader is studying, or else in the most advanced one.
const views = await Promise.all(availableCerts().map((c) => getCertView(c.id, locale)));
const byLevel = [...views].sort((a, b) => levelRank(b.cert.level) - levelRank(a.cert.level));
const certsOf = new Map<string, string[]>();
for (const view of byLevel) for (const s of view.sections) certsOf.set(s.id, [...(certsOf.get(s.id) ?? []), view.cert.id]);
const codeOf = new Map(views.map((v) => [v.cert.id, v.cert.code]));
const indexed = new Set<string>();
const index = views.flatMap((view) =>
  view.units.flatMap(({ unit, sections }) =>
    sections.flatMap((s) => {
      if (indexed.has(s.id)) return [];
      indexed.add(s.id);
      const ids = certsOf.get(s.id)!;
      const cert = ids.map((id) => codeOf.get(id)).join(' ');
      const topic = unit.data.title;
      const links = (path: (certId: string) => string) => ids.map((id) => [id, localePath(locale, path(id))]);
      return [
        { kind: 'section', cert, title: s.data.title, text: `${topic} ${s.body ?? ''}`, links: links((id) => sectionHref(id, s)), topic },
        ...s.data.cards.map((c) => ({ kind: 'card', cert, title: c.q, text: `${c.a} ${topic}`, links: links((id) => `/${id}/${unitIdOf(s)}#cards`), topic })),
      ];
    }),
  ),
);
---
<Base title={t('nav.search')} description={t('search.description')}>
  <div class="article">
    <h1>{t('nav.search')}</h1>
  </div>
  <input type="search" placeholder={t('search.placeholder')} aria-label={t('nav.search')} autofocus data-search />
  <ul class="results" data-results></ul>
  <script type="application/json" data-index set:html={jsonForScript(index)} />
</Base>

<style>
  .results { list-style: none; padding: 0; margin-top: 1rem; }
  .results :global(li) { padding: 0.5rem 0; border-bottom: 1px solid var(--ink-700); }
  .results :global(small) { color: var(--ink-300); display: block; }
  .results :global(.k) { font-size: 0.7rem; text-transform: uppercase; margin-right: 0.5rem; color: var(--purple); }
  .results :global(.c) { font-size: 0.7rem; margin-right: 0.5rem; color: var(--amber); }
</style>

<script>
  import { escapeHtml as esc } from '../../lib/format';
  import { clientT } from '../../i18n';
  import { readRecent } from '../../lib/recent';
  type Entry = { kind: string; cert: string; title: string; text: string; links: [string, string][]; topic?: string };
  document.addEventListener('astro:page-load', () => {
    const input = document.querySelector<HTMLInputElement>('[data-search]');
    if (!input || input.dataset.ready) return;
    input.dataset.ready = '1';
    const t = clientT();
    const index: Entry[] = JSON.parse(document.querySelector('[data-index]')!.textContent!);
    const out = document.querySelector<HTMLElement>('[data-results]')!;
    const current = readRecent()?.cert;
    const hrefOf = (e: Entry) => (e.links.find(([cert]) => cert === current) ?? e.links[0])[1];
    const run = () => {
      const terms = input.value.toLowerCase().split(/\s+/).filter(Boolean);
      if (!terms.length) { out.innerHTML = ''; return; }
      const hits = index
        .map((e) => {
          const title = e.title.toLowerCase();
          const hay = `${title} ${e.text.toLowerCase()} ${e.cert.toLowerCase()}`;
          if (!terms.every((t) => hay.includes(t))) return null;
          return { e, score: terms.reduce((s, t) => s + (title.includes(t) ? 3 : 1), 0) + (e.kind === 'section' ? 2 : 0) };
        })
        .filter((x): x is { e: Entry; score: number } => !!x)
        .sort((a, b) => b.score - a.score)
        .slice(0, 40);
      out.innerHTML = hits.length
        ? hits.map(({ e }) => `<li><span class="c">${esc(e.cert)}</span><span class="k">${t(e.kind === 'card' ? 'search.kind.card' : 'search.kind.section')}</span><a href="${hrefOf(e)}">${esc(e.title.replace(/[*`]/g, ''))}</a>${e.topic ? `<small>${esc(e.topic)}</small>` : ''}</li>`).join('')
        : `<li class="muted">${esc(t('search.none'))}</li>`;
    };
    input.addEventListener('input', run);
    const q = new URLSearchParams(location.search).get('q');
    if (q) { input.value = q; run(); }
  });
</script>
