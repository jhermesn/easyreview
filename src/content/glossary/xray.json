[
  {
    "term": "Distributed tracing",
    "aliases": [],
    "definition": "Recording connected work across services to follow a request through an application.",
    "source": "https://docs.aws.amazon.com/xray/latest/devguide/xray-concepts.html"
  },
  {
    "term": "Trace",
    "aliases": [],
