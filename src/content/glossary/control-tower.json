[
  {
    "term": "Landing zone",
    "aliases": [],
    "definition": "A multi-account environment containing the accounts, identities, and resources subject to governance.",
    "source": "https://docs.aws.amazon.com/controltower/latest/userguide/what-is-control-tower.html#features"
  },
  {
    "term": "Organizational unit",
    "aliases": [
      "OU"
    ],
    "definition": "A grouping of accounts within an AWS organization hierarchy.",
    "source": "https://docs.aws.amazon.com/controltower/latest/userguide/how-control-tower-works.html#landing-zone-structure"
  },
  {
    "term": "Baseline",
    "aliases": [],
    "definition": "A collection of resources and configurations applied to a governance target.",
    "source": "https://docs.aws.amazon.com/controltower/latest/userguide/types-of-baselines.html#types-of-baselines"
  },
  {
    "term": "Control",
    "aliases": [
      "Guardrail"
    ],
    "definition": "An ongoing governance rule applied to an AWS environment.",
    "source": "https://docs.aws.amazon.com/controltower/latest/controlreference/controls.html#controls"
  },
  {
    "term": "Service control policy",
    "aliases": [
      "SCP"
    ],
    "definition": "An organization policy that limits the permissions available to identities in member accounts without granting permissions.",
    "source": "https://docs.aws.amazon.com/organizations/latest/userguide/orgs_manage_policies_scps.html"
  },
  {
    "term": "Resource control policy",
    "aliases": [
      "RCP"
    ],
    "definition": "An organization policy that limits permissions available on member-account resources without granting permissions.",
    "source": "https://docs.aws.amazon.com/organizations/latest/userguide/orgs_manage_policies_rcps.html"
  },
  {
    "term": "Declarative policy",
    "aliases": [],
    "definition": "An organization policy that enforces the desired configuration of a supported AWS service.",
    "source": "https://docs.aws.amazon.com/organizations/latest/userguide/orgs_manage_policies_declarative_policies.html"
  },
  {
    "term": "CloudFormation hook",
    "aliases": [
      "Hook"
    ],
    "definition": "A check that evaluates a CloudFormation resource before provisioning and can block a noncompliant resource.",
    "source": "https://docs.aws.amazon.com/controltower/latest/controlreference/control-behavior.html#control-behavior"
  },
  {
    "term": "Blueprint",
    "aliases": [],
    "definition": "A Service Catalog product defining the resources and configuration applied to an account by AFC.",
    "source": "https://docs.aws.amazon.com/controltower/latest/userguide/af-customization-page.html#af-customization-page"
  },
  {
    "term": "Hub account",
    "aliases": [],
    "definition": "The account that stores Service Catalog blueprint products for AFC.",
