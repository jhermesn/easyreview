  },
  {
    "term": "Lifecycle event",
    "aliases": [],
    "definition": "An event recording the completed result of a Control Tower operation.",
    "source": "https://docs.aws.amazon.com/controltower/latest/userguide/lifecycle-events.html#lifecycle-events"
  },
  {
    "term": "Manifest",
    "aliases": [],
    "definition": "A file describing the resources and targets in a CfCT configuration package.",
