[
  {
    "term": "Shard",
    "aliases": [],
    "definition": "A shard is an ordered record sequence that provides a unit of stream capacity.",
    "source": "https://docs.aws.amazon.com/streams/latest/dev/key-concepts.html#shard"
  },
  {
    "term": "Partition key",
    "aliases": [],
    "definition": "A partition key groups records by mapping them to a shard through a hash value.",
    "source": "https://docs.aws.amazon.com/streams/latest/dev/key-concepts.html#partition-key"
  },
  {
    "term": "Sequence number",
    "aliases": [],
    "definition": "A sequence number identifies a record position within its shard.",
    "source": "https://docs.aws.amazon.com/streams/latest/dev/key-concepts.html#sequence-number"
  },
  {
    "term": "Hot key",
    "aliases": [
      "hot partition key"
    ],
    "definition": "A hot key concentrates traffic on one shard until the shard cannot accept more work.",
    "source": "https://docs.aws.amazon.com/streams/latest/dev/how-do-i-size-a-stream.html#ondemandmode"
  },
  {
    "term": "Aggregation",
    "aliases": [
      "KPL aggregation"
    ],
    "definition": "Aggregation combines multiple application records inside one Kinesis record.",
    "source": "https://docs.aws.amazon.com/streams/latest/dev/kinesis-kpl-concepts.html#kinesis-kpl-concepts-aggretation"
  },
  {
    "term": "Collection",
    "aliases": [
      "KPL collection"
    ],
    "definition": "Collection sends multiple Kinesis records in one PutRecords request.",
    "source": "https://docs.aws.amazon.com/streams/latest/dev/kinesis-kpl-concepts.html#kinesis-kpl-concepts-collection"
  },
  {
    "term": "Burst capacity",
    "aliases": [],
    "definition": "Burst capacity temporarily accepts intermittent large records above the sustained stream rate.",
    "source": "https://docs.aws.amazon.com/streams/latest/dev/large-records.html#how-large-records-work"
  },
  {
    "term": "Retention period",
    "aliases": [
      "retention"
    ],
    "definition": "The retention period is how long a written record remains accessible in the stream.",
