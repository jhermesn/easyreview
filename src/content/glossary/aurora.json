  },
  {
    "term": "reader",
    "aliases": [
      "replica",
      "Aurora Replica"
    ],
    "definition": "A read-only database instance that shares the writer storage and can be promoted after writer failure.",
    "source": "https://docs.aws.amazon.com/AmazonRDS/latest/AuroraUserGuide/Aurora.Overview.html#Aurora.Overview"
  },
  {
    "term": "Availability Zone",
    "aliases": [
      "AZ"
    ],
    "definition": "An isolated location in an AWS Region used to separate instance failures.",
    "source": "https://docs.aws.amazon.com/AmazonRDS/latest/AuroraUserGuide/Concepts.AuroraHighAvailability.html#Concepts.AuroraHighAvailability"
  },
  {
    "term": "endpoint",
    "aliases": [],
    "definition": "A database connection address that selects the appropriate instance or group of instances.",
    "source": "https://docs.aws.amazon.com/AmazonRDS/latest/AuroraUserGuide/Aurora.Overview.Endpoints.html#Aurora.Overview.Endpoints"
  },
  {
    "term": "cluster endpoint",
    "aliases": [
      "writer endpoint"
    ],
    "definition": "The connection address that follows the current writer in an Aurora cluster.",
