[
  {
    "term": "cluster volume",
    "aliases": [
      "shared volume"
    ],
    "definition": "The shared storage holding data for the writer and readers of an Aurora cluster.",
    "source": "https://docs.aws.amazon.com/AmazonRDS/latest/AuroraUserGuide/Aurora.Overview.StorageReliability.html#Aurora.Overview.StorageReliability"
  },
  {
    "term": "writer",
    "aliases": [
      "primary instance"
    ],
    "definition": "The database instance that modifies the shared cluster data.",
