  },
  {
    "term": "asynchronous replication",
    "aliases": [],
    "definition": "Copying writes to another Region after they can already be committed on the primary.",
    "source": "https://docs.aws.amazon.com/AmazonRDS/latest/AuroraUserGuide/aurora-global-database-disaster-recovery.html#aurora-global-database-disaster-recovery"
  },
  {
    "term": "replication lag",
    "aliases": [],
    "definition": "How far a secondary database is behind the primary in receiving changes.",
    "source": "https://docs.aws.amazon.com/AmazonRDS/latest/AuroraUserGuide/aurora-global-database-disaster-recovery.html#aurora-global-database-disaster-recovery"
  },
  {
    "term": "recovery point objective",
    "aliases": [
      "RPO"
    ],
    "definition": "The acceptable amount of recent data loss expressed as a time interval.",
    "source": "https://docs.aws.amazon.com/AmazonRDS/latest/AuroraUserGuide/aurora-global-database-disaster-recovery.html#aurora-global-database-disaster-recovery"
  },
  {
    "term": "recovery time objective",
    "aliases": [
      "RTO"
    ],
    "definition": "The time allowed for a system to return to service after an outage.",
    "source": "https://docs.aws.amazon.com/AmazonRDS/latest/AuroraUserGuide/aurora-global-database-disaster-recovery.html#aurora-global-database-disaster-recovery"
  },
  {
    "term": "switchover",
    "aliases": [
      "managed planned failover"
    ],
    "definition": "A planned primary-Region change that synchronizes the secondary before promotion.",
    "source": "https://docs.aws.amazon.com/AmazonRDS/latest/AuroraUserGuide/aurora-global-database-disaster-recovery.html#aurora-global-database-disaster-recovery"
  },
  {
    "term": "failover",
    "aliases": [],
    "definition": "Promoting a replacement writer or primary cluster to recover from failure.",
    "source": "https://docs.aws.amazon.com/AmazonRDS/latest/AuroraUserGuide/aurora-global-database-disaster-recovery.html#aurora-global-database-disaster-recovery"
  },
  {
    "term": "write fencing",
    "aliases": [],
    "definition": "An attempt to stop writes to the old primary during global failover.",
    "source": "https://docs.aws.amazon.com/AmazonRDS/latest/AuroraUserGuide/aurora-global-database-disaster-recovery.html#aurora-global-database-disaster-recovery"
  },
  {
    "term": "split-brain",
    "aliases": [],
    "definition": "A condition where old and new primary clusters can both accept writes.",
    "source": "https://docs.aws.amazon.com/AmazonRDS/latest/AuroraUserGuide/aurora-global-database-disaster-recovery.html#aurora-global-database-disaster-recovery"
  },
  {
    "term": "DNS",
    "aliases": [
      "Domain Name System"
    ],
    "definition": "The name resolution mechanism through which an endpoint follows a new primary.",
    "source": "https://docs.aws.amazon.com/AmazonRDS/latest/AuroraUserGuide/aurora-global-database-disaster-recovery.html#aurora-global-database-disaster-recovery"
  },
  {
    "term": "global writer endpoint",
    "aliases": [],
