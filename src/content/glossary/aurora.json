  },
  {
    "term": "target tracking",
    "aliases": [],
    "definition": "A scaling policy that adjusts reader count to keep a metric near a chosen value.",
    "source": "https://docs.aws.amazon.com/AmazonRDS/latest/AuroraUserGuide/Aurora.Integrating.AutoScaling.html#Aurora.Integrating.AutoScaling"
  },
  {
    "term": "scalable dimension",
    "aliases": [],
