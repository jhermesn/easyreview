              "kind": "objective",
              "text": "Identify AWS services and features to secure AI systems (for example, IAM roles, policies, and permissions; encryption; Amazon Macie; AWS PrivateLink; AWS shared responsibility model; Amazon Bedrock AgentCore Identity; Policy in AgentCore; Amazon Bedrock Guardrails).",
              "sections": [
                "ai-security-governance/securing-ai-workloads",
                "bedrock/security-and-monitoring",
                "iam/users-groups-and-policies",
                "iam/roles-basics",
                "kms/encryption-at-rest-and-in-transit",
                "macie/basics",
                "privatelink/basics",
                "shared-responsibility/security-of-and-in-the-cloud",
                "secrets-manager/basics",
                "bedrock-agentcore/agentcore-services",
                "bedrock/guardrails"
              ]
            },
            {
              "id": "5.1.o2",
              "kind": "objective",
              "text": "Describe the concept of source citation and documenting data origins (for example, data lineage, data cataloging, Amazon SageMaker Model Cards).",
              "sections": [
                "ai-security-governance/data-governance",
                "bedrock/knowledge-bases-and-rag",
                "glue/data-integration-and-catalog",
                "sagemaker-ai/mlops-and-governance"
              ]
            },
            {
              "id": "5.1.o3",
              "kind": "objective",
              "text": "Describe best practices for secure data engineering (for example, assessing data quality, implementing privacy-enhancing technologies, data access control, data integrity).",
              "sections": [
                "ai-security-governance/data-governance",
                "lake-formation/data-lake-governance",
                "glue/databrew"
              ]
            },
            {
              "id": "5.1.o4",
              "kind": "objective",
              "text": "Describe security and privacy considerations for AI systems (for example, application security, threat detection, vulnerability management, infrastructure protection, prompt injection, encryption at rest and in transit, data leakage prevention, output filtering and validation, audit trail and logging requirements for AI interactions, toxicity).",
              "sections": [
                "ai-security-governance/securing-ai-workloads",
                "prompt-engineering/prompt-attacks",
                "bedrock/guardrails",
                "bedrock/security-and-monitoring",
                "inspector/basics",
                "vpc/security-basics",
                "cloudfront/basics"
              ]
            },
            {
              "id": "5.1.o5",
              "kind": "objective",
              "text": "Describe hallucination detection methods and grounding techniques to improve output accuracy (for example, Retrieval Augmented Generation [RAG] grounding, output validation, confidence scoring).",
              "sections": [
                "ai-security-governance/grounding-and-hallucinations",
                "bedrock/guardrails"
              ]
            }
          ]
        },
        {
          "id": "5.2",
          "title": "Recognize governance and compliance regulations for AI systems.",
          "items": [
            {
              "id": "5.2.o1",
              "kind": "objective",
              "text": "Identify AWS services and features to assist with governance and regulation compliance (for example, AWS Config, Amazon Inspector, AWS Artifact, AWS CloudTrail, AWS Trusted Advisor).",
              "sections": [
                "config/basics",
                "inspector/basics",
                "artifact/reports-and-agreements",
                "cloudtrail/basics",
                "trusted-advisor/basics"
              ]
            },
            {
              "id": "5.2.o2",
              "kind": "objective",
              "text": "Describe data governance strategies (for example, data lifecycles, logging, residency, monitoring, observation, retention).",
              "sections": [
                "ai-security-governance/data-governance",
                "s3/lifecycle-basics",
                "s3/storage-classes",
                "cloudwatch/basics",
                "cloudtrail/basics"
              ]
            },
            {
              "id": "5.2.o3",
              "kind": "objective",
              "text": "Describe processes to follow governance protocols (for example, policies, review cadence, review strategies, governance frameworks such as the Generative AI Security Scoping Matrix, transparency standards, team training requirements).",
              "sections": [
                "ai-security-governance/securing-ai-workloads",
                "ai-security-governance/data-governance",
                "well-architected/well-architected-tool"
              ]
            }
          ]
        }
      ]
