{
  "name": "easyreview",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/sync-aws-icons.mjs --check && astro build",
    "preview": "astro preview",
    "lint": "node scripts/lint-content.mjs",
    "translations": "node scripts/translations.mjs",
    "lint:links": "lychee 'src/content/sections/**/*.md' 'src/content/glossary/*.json'",
    "test": "vitest run",
    "typecheck": "astro sync && tsc --noEmit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.9",
    "astro": "7.4.11",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@types/three": "0.187.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
